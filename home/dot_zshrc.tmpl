{{ if lookPath "bartib" -}}
# Set bartib activities file location
export BARTIB_FILE="$HOME/.cache/activities.bartib"
{{ end }}

# lazy-load heavy plugins with function wrappers where possible
# Example: defer `kubectl` completion until first use
if (( $+commands[kubectl] )); then
  __kube_loaded=0
  kubectl() {
    if (( ! __kube_loaded )); then
      __kube_loaded=1
      source <(command kubectl completion zsh)
    fi
    command kubectl "$@"
  }
fi

# Generate profiling report if ZPROF is set to true
if [[ "$ZPROF" == "true" ]]; then
  zprof
fi

# Disable shell tracing
# set +x
