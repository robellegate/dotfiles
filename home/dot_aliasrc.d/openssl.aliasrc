###################
# openssl aliases #
###################

# Function: certdates
# Description: Display the start and end dates of a given host's SSL certificate
# Usage: certdates [host] <port>
function certdates() {
    local host=$1
    local port=${2:-443}

    if [[ ! "$host" ]]; then
        echo "You must supply a host."
        return 0
    fi

    echo | openssl s_client -servername $host -connect $host:$port 2>/dev/null | openssl x509 -noout -dates
}
